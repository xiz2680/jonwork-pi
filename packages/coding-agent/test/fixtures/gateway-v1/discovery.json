{
	"contract": "pi-gateway/1.0",
	"apiVersion": "1.0",
	"authentication": {
		"type": "oauth2_authorization_code",
		"authorizationEndpoint": "https://gateway.example.test/oauth/authorize",
		"tokenEndpoint": "https://gateway.example.test/oauth/token",
		"pkceMethods": ["S256"]
	},
	"capabilities": {
		"repositories": true,
		"models": true,
		"thinking": true,
		"sessions": true,
		"commands": true,
		"sse": true,
		"authoritativeSnapshot": true,
		"eventIds": true,
		"replay": true,
		"idempotency": true,
		"singleWriter": true,
		"takeover": true,
		"release": true,
		"abort": true,
		"retry": true,
		"attachments": {"images": true, "files": false}
	},
	"limits": {
		"readTimeoutMs": 10000,
		"mutationTimeoutMs": 30000,
		"sseConnectTimeoutMs": 15000,
		"replayRetentionEvents": 2048,
		"replayRetentionSeconds": 3600,
		"idempotencyRetentionSeconds": 86400,
		"attachmentMaxBytes": 10485760,
		"attachmentTotalBytes": 20971520,
		"attachmentsPerPrompt": 4,
		"attachmentUploadTimeoutMs": 30000
	}
}
