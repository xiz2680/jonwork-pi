{
	"contract": "pi-gateway/1.0",
	"apiVersion": "1.0",
	"authentication": {
		"type": "oauth2_authorization_code",
		"clientId": "pi-ios",
		"authorizationEndpoint": "https://gateway.example.test/v1/auth/authorize",
		"tokenEndpoint": "https://gateway.example.test/v1/auth/token",
		"revocationEndpoint": "https://gateway.example.test/v1/auth/revoke",
		"scopes": ["pi.gateway"],
		"pkceMethods": ["S256"],
		"accessTokenLifetimeSeconds": 900,
		"refreshTokenRotation": "required"
	},
	"capabilities": {
		"repositories": true,
		"models": true,
		"thinking": true,
		"sessions": true,
		"commands": true,
		"sse": true,
		"authoritativeSnapshot": true,
		"eventIds": true,
		"replay": true,
		"idempotency": true,
		"singleWriter": true,
		"takeover": true,
		"release": true,
		"abort": true,
		"retry": true,
		"attachments": {"images": true, "files": false}
	},
	"limits": {
		"readTimeoutMs": 10000,
		"mutationTimeoutMs": 30000,
		"sseConnectTimeoutMs": 15000,
		"replayRetentionEvents": 2048,
		"replayRetentionSeconds": 3600,
		"idempotencyRetentionSeconds": 86400,
		"attachmentMaxBytes": 10485760,
		"attachmentTotalBytes": 20971520,
		"attachmentsPerPrompt": 4,
		"attachmentUploadTimeoutMs": 30000,
		"attachmentDownloadTimeoutMs": 30000,
		"attachmentMediaTypes": ["image/png", "image/jpeg", "image/webp"],
		"attachmentDigestAlgorithm": "sha-256"
	}
}
